# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: API Key for Google Maps Directions & Distance matrix
GOOGLE_MAPS_PLATFORM_KEY=""

# Contact Form Email Destinations (Defaults to Hamdan7394@gmail.com and info@orinexai.com)
CONTACT_PRIMARY_EMAIL="Hamdan7394@gmail.com"
CONTACT_SECONDARY_EMAIL="info@orinexai.com"

# Optional SMTP Configuration for automated backend email dispatch (e.g. Gmail App Password, Resend, Sendgrid, Mailgun)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
